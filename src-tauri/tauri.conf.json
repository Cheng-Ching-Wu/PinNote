{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinNote",
  "version": "0.4.0",
  "identifier": "com.pinnote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzREU0NzE4QkNENkNCOTcKUldTWHk5YThHRWZlRS82aVR4NmZHWFNjRm9KQ25oS1JieEl1UDQwZjN6d1RhNWcrQ1FUVndrV1EK",
      "endpoints": [
        "https://github.com/Cheng-Ching-Wu/PinNote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
